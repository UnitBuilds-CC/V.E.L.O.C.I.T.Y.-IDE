# Justfile for V.E.L.O.C.I.T.Y.
# Install `just` from https://github.com/casey/just

set shell := ["sh", "-cu"]
set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

python_cmd := if os_family() == "windows" { "python" } else { "python3" }

# Default: run everything
_default:
    @just --list

# Fast typecheck
check:
    cargo check --all-targets

# Run tests
test:
    cargo test

# Static analysis
clippy:
    cargo clippy -- -D warnings

# Format code
fmt:
    cargo fmt

# Run the GUI
gui:
    cargo run --release --bin velocity_ide_gui

# Run the MCP server (headless)
run:
    cargo run --bin velocity_mcp -- --mode stdio

# Build release binary
release:
    cargo build --release

# Validate current state (used by orchestrator)
validate:
    cargo check --all-targets
    cargo test
    cargo clippy -- -D warnings

# Generate structured diagnostics JSON
diag:
    {{python_cmd}} scripts/check.py
