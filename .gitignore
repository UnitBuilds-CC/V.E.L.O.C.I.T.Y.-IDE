# Rust build artifacts
target/
**/*.exe
**/*.pdb
**/*.d

# Installer build artifacts (staged binaries and compiled installers)
/dist/
/output/

# Release archives
*.zip
*.msi

# Local agent runtime state and logs
**/.velocity/

# Build/test output logs (never tracked; regenerable artifacts)
*.log

# Flaky test detection history (local tracking, not committed)
.flaky-history/

# Benchmark baselines (local; CI regenerates each run)
target/bench-baselines/
target/bench-results/

# Stray dev artifacts (ad-hoc captures, tool output & shell-redirect typos - never tracked)
$null
commit_msg.txt

# A directory at the repository root whose name begins with a dash is a
# command-line flag that was read as a workspace path, not a folder: launching
# with `velocity_mcp --editor` once wrote `--editor/memory/` and it stayed in the
# index for two months. No legitimate top-level entry looks like this.
/-*

# Local test/verification scratch dirs - regenerable, never committed
.velocity_testing/
.verify_tmp/
scratch/
browser_screenshot.png
test_out.txt
test_err.txt
test_output.txt
test_lexer.txt
warnings.txt
# Generated by sweep_gui.ps1; the script itself is tracked, its output is not
sweep_report.txt

# Telemetry test artifacts
telemetry*.bin

# Model weights (too large for git; download separately)
models/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
ENV/
.env
.env.local
.env.*.local

# Secrets & key material - never commit.
# A Chrome extension signing key (browsing/extension/src.pem) was purged from
# history after being committed here; these patterns keep that from recurring.
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.crx
*.keystore
*.jks
id_rsa
id_ed25519
credentials.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Qoder IDE state is tracked, except ephemeral canvas render-state sidecars
.qoder/canvases/*.canvas.status.json

# Cloudflare Workers state
.wrangler/

# NDA compiled output
*.nda

# Memory (local agent state)
#
# Basename patterns, deliberately not `memory/…` ones: a gitignore pattern that
# contains a slash is anchored to the directory holding this file, so the old
# `memory/.account_usage.json` form said nothing about the same file under
# `velocity-mcp/memory/` — which is how three copies of one machine's quota
# counters got committed. `usage::UsageTracker::STATE_FILE_NAMES` is the list
# these rules have to cover, and `usage::tests` checks each name against this
# file at every depth. `.account_usage.nda` needs no line here: the `*.nda`
# artifact rule above already matches it by basename.
.account_state.json
.account_usage.json
session.jsonl
**/memory/summaries/
**/memory/snapshots/
