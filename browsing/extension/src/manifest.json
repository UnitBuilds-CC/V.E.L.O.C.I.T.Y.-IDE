{
  "manifest_version": 3,
  "name": "Ghost Bridge",
  "version": "1.0",
  "key": "",
  "description": "Zero-CDP Browser Bridge",
  "incognito": "spanning",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
