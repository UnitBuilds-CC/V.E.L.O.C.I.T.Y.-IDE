# EditorConfig — consistent coding styles across editors
# See: https://editorconfig.org

root = true

# ─── Rust ────────────────────────────────────────────────────────────────────
[*.{rs,toml}]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

# ─── Markdown ────────────────────────────────────────────────────────────────
[*.md]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# ─── YAML / GitHub Actions ───────────────────────────────────────────────────
[*.{yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# ─── JSON ────────────────────────────────────────────────────────────────────
[*.json]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# ─── Shell scripts ───────────────────────────────────────────────────────────
[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# ─── PowerShell ──────────────────────────────────────────────────────────────
[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# ─── Batch files ─────────────────────────────────────────────────────────────
[*.{bat,cmd}]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# ─── Dockerfile ──────────────────────────────────────────────────────────────
[Dockerfile*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# ─── Makefiles / Justfiles ───────────────────────────────────────────────────
[{Makefile,justfile,Justfile}]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
